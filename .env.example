# Copy to .env.local and fill in. Only this example file is committed.
# Add the same values in Netlify under Site configuration, Environment variables.

# ---- App secrets ----
# Each one should be a long random value, at least 32 characters.
NUXT_ADMIN_PASSCODE=
NUXT_JWT_SECRET=
NUXT_EMAIL_PEPPER=
# Changing the pepper after codes are imported breaks every stored code hash.

# The address players open. Printed on the stage join card and its QR code.
NUXT_PUBLIC_JOIN_URL=https://ghoul-tidings.netlify.app

# ---- Supabase: Project URL and keys ----
# Copy menu on the project home, or Project Settings, API Keys.
NUXT_PUBLIC_SUPABASE_URL=https://aiwecralpnvjbkubewvd.supabase.co
# The publishable key starts with sb_publishable_. Browsers use it to subscribe to live updates.
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key starts with sb_secret_. Server only, so never add NUXT_PUBLIC_ to this name.
NUXT_SUPABASE_SECRET_KEY=

# ---- Supabase: Postgres connection strings ----
# Connect button, then Connection string. Replace [YOUR-PASSWORD] with the database password.
# Transaction pooler, port 6543. The app uses this one on Netlify.
NUXT_DATABASE_URL=
# Session pooler, port 5432. Used only to run migrations from your machine.
NUXT_DATABASE_MIGRATION_URL=

# ---- Signing keys for live updates ----
# Leave these blank. Claude generates the pair when wiring up Realtime.
NUXT_BROADCAST_PRIVATE_KEY=
NUXT_PUBLIC_BROADCAST_PUBLIC_KEY=
